# Copy this file to `.env` and fill in real values. `.env` is gitignored.
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Endpoint guardrails
# Max upload size in bytes (default 8 MB) and per-IP rate limit on /analyze.
MAX_UPLOAD_BYTES=8388608
ANALYZE_RATE_LIMIT=10/minute

# Optional: enables GPT-4o personalized styling explanations.
# Leave blank to run the app without the LLM (falls back to static descriptions).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o